{
  "name": "warrentywise-test",
  "private": true,
  "workspaces": [
    "component-library-package",
    "store"
  ],
  "scripts": {
    "dev": "npm --workspace store run dev",
    "build": "npm --workspace component-library-package run build && npm --workspace store run build",
    "test": "npm --workspace @local/components run test && npm --workspace store run test",
    "test:components": "npm --workspace @local/components run test",
    "test:store": "npm --workspace store run test",
    "storybook:components": "npm --workspace component-library-package run storybook",
    "build-storybook:components": "npm --workspace component-library-package run build-storybook",
    "storybook:store": "npm --workspace store run storybook",
    "build-storybook:store": "npm --workspace store run build-storybook",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
